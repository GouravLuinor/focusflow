# FocusFlow Environment Variables
# Copy this file to .env and fill in your values
# WARNING: .env contains real secrets and is gitignored - never commit it

# JWT Configuration (required)
SECRET_KEY=generate-a-random-secret-key-at-least-32-chars

# Gemini AI (optional - backend starts without it, only AI features degrade)
GEMINI_API_KEY=your_gemini_api_key_here

# Database (optional - defaults to SQLite if not set)
# For PostgreSQL: DATABASE_URL=postgresql://focusflow:focusflow_dev@localhost:5432/focusflow
# DATABASE_URL=sqlite:///./dev.db

# Redis (optional - defaults to localhost for development)
# REDIS_URL=redis://localhost:6379/0
